---
import { Image } from 'astro:assets';

import Centered from '@/layouts/Centered.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import PaperCard from '@/components/PaperCard.astro';
import PolaroidCard from '@/components/PolaroidCard.astro';
import { BreadcrumbItemHome } from '@/constants/breadcrumb';
import { PROFILE } from '@/constants/profile';
import { ROUTES } from '@/constants/routes';
import { CONFIG_CLIENT } from '@/config/client';
import { getPageMetadata } from '@/utils/metadata';

import MeInBlackSrc from '@/assets/images/mazipan-in-black.jpg';

const {
  SITE_URL,
  AUTHOR_NAME,
  AUTHOR_GITHUB,
  AUTHOR_LINKEDIN,
  AUTHOR_TWITTER,
  AUTHOR_YOUTUBE,
  AUTHOR_EMAIL,
} = CONFIG_CLIENT;

const breadcrumbs = [BreadcrumbItemHome];
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: '2019-12-19T12:34:00-05:00',
  dateModified: '2024-12-18T14:53:00-05:00',
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: SITE_URL + ROUTES.ABOUT,
    email: AUTHOR_EMAIL,
    sameAs: [AUTHOR_LINKEDIN, AUTHOR_TWITTER, AUTHOR_YOUTUBE],
    alternateName: 'mazipan',
    image: SITE_URL + '/avatars/avatar-mazipan.png',
  },
});

const metadata = getPageMetadata('pages/about');
---

<Centered {metadata}>
  <article class="flex flex-col">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="b-h1">I'm Irfan Maulana.</h1>
    <b>You can call me "mas ipan"</b>
    <div class="my-8 flex flex-col-reverse gap-16 md:flex-row md:items-start md:justify-between">
      <div class="space-y-6">
        <p>{PROFILE.TAGLINE}</p>
        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">I write some stuffs</h2>
          <p>
            I don’t write all that often, but you’re welcome to explore my public writings. I mostly
            share personal experiences on technical topics and occasionally throw in some
            beginner-friendly advice from my perspective.{' '}
            <a href={ROUTES.BLOG} class="link-key">
              Visit my blog
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">Randomly speaking</h2>
          <p>
            I speak on a variety of topics, including JavaScript, React.js, Next.js, and web
            technologies in general. I also cover areas like contributing to open source, exploring
            architectural approaches in frontend development, and choosing the right tech stack to
            align with your team’s needs. Additionally, I enjoy sharing insights on how to advance
            your skills as an engineer and providing career advice based on my personal experiences,
            all with the goal of empowering others to grow and succeed in their professional
            journeys. Would you like to invite me to speak at your event?
            <a href={ROUTES.TALKS} title="Talks" class="link-key">
              Check my latest talks.
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">One on one discussion</h2>
          <p>
            I provide one-on-one mentorship through ADPList, which I like to describe as more of a
            two-way discussion than a traditional mentorship. I understand that I may not always be
            better or more experienced than the person I’m mentoring, but I aim to share my
            perspectives and insights. I particularly enjoy discussing non-technical topics related
            to professional careers and productivity as a software engineer, though I’m also open to
            technical discussions about web technologies and related areas.
            <a
              href="https://dub.sh/mzp.adp"
              target="_blank"
              rel="me noreferrer noopener"
              title="ADPList"
              class="link-key"
            >
              Check my ADPList profile.
            </a>
          </p>
        </PaperCard>
        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">#Build in public</h2>
          <p>
            I enjoy sharing my projects with the public, as I often build them for fun and to
            explore new concepts or technologies. I actively contribute to and maintain community
            projects, including PHPID, React.js ID, and KawalCovid19. With over 11 years of
            experience in frontend development, I’m passionate about “giving back” by sharing my
            expertise with the broader community and supporting others in their learning journeys.
            <a
              href={AUTHOR_GITHUB}
              target="_blank"
              rel="me noreferrer noopener"
              title="GitHub"
              class="link-key"
            >
              Check my public code
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" tape class="space-y-3">
          <h2 class="b-h2 mt-0">Want to work together?</h2>

          <div class="flex flex-col items-start gap-2">
            <div class="flex items-center gap-2">
              <span class="relative flex h-3 w-3">
                <span class="bg-primary absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"></span>
                <span class="bg-primary relative inline-flex h-3 w-3 rounded-full"></span>
              </span>
              <span class="text-primary">Available for hire</span>
            </div>
            <Button
              element="a"
              colors="primary"
              variant="solid"
              href={`mailto:${AUTHOR_EMAIL}`}
              target="_blank"
              rel="me noreferrer noopener"
              title="Email"
            >
              Send me an email
            </Button>
            <small>
              Or copy this email manually: <code class="font-mono">{AUTHOR_EMAIL}</code>
            </small>
          </div>
        </PaperCard>
      </div>
      <div class="flex items-center justify-center md:min-w-[300px]">
        <PolaroidCard as="div" class="w-[300px] max-w-full">
          <Image
            slot="photo"
            width={300}
            densities={[1, 2]}
            src={MeInBlackSrc}
            alt="Irfan Maulana, smiling, arms crossed, in a black t-shirt"
            class="w-full"
          />
        </PolaroidCard>
      </div>
    </div>
  </article>
</Centered>
<script type="application/ld+json" set:html={schema} />
