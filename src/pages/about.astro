---
import { Image } from 'astro:assets';

import Centered from '@/layouts/Centered.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import PaperCard from '@/components/PaperCard.astro';
import PolaroidCard from '@/components/PolaroidCard.astro';
import { BreadcrumbItemHome } from '@/constants/breadcrumb';
import { PROFILE } from '@/constants/profile';
import { ROUTES } from '@/constants/routes';
import { CONFIG_CLIENT } from '@/config/client';
import { getPageMetadata } from '@/utils/metadata';

import MeInBlackSrc from '@/assets/images/mazipan-in-black.jpg';

const {
  SITE_URL,
  AUTHOR_NAME,
  AUTHOR_GITHUB,
  AUTHOR_LINKEDIN,
  AUTHOR_TWITTER,
  AUTHOR_YOUTUBE,
  AUTHOR_EMAIL,
} = CONFIG_CLIENT;

const breadcrumbs = [BreadcrumbItemHome];
const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  dateCreated: '2019-12-19T12:34:00-05:00',
  dateModified: '2024-12-18T14:53:00-05:00',
  mainEntity: {
    '@type': 'Person',
    name: AUTHOR_NAME,
    url: SITE_URL + ROUTES.ABOUT,
    email: AUTHOR_EMAIL,
    sameAs: [AUTHOR_LINKEDIN, AUTHOR_TWITTER, AUTHOR_YOUTUBE],
    alternateName: 'mazipan',
    image: SITE_URL + '/avatars/avatar-mazipan.png',
  },
});

const metadata = getPageMetadata('pages/about');
---

<Centered {metadata}>
  <article class="flex flex-col">
    <Breadcrumbs items={breadcrumbs} />
    <h1 class="b-h1">I'm Irfan Maulana.</h1>
    <b>You can call me "mas ipan"</b>
    <div class="my-8 flex flex-col-reverse gap-16 md:flex-row md:items-start md:justify-between">
      <div class="space-y-6">
        <p>{PROFILE.TAGLINE}</p>
        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">What I write</h2>
          <p>
            I don’t write often, but when I do it is usually a personal experience on a technical
            topic, with some beginner-friendly advice from my side.{' '}
            <a href={ROUTES.BLOG} class="link-key">
              Visit my blog
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">Where I speak</h2>
          <p>
            I speak about JavaScript, React.js, Next.js and the web in general, plus open source,
            frontend architecture, choosing a tech stack that fits your team, and growing as an
            engineer with advice from my own career. Want me at your event?{' '}
            <a href={ROUTES.TALKS} title="Talks" class="link-key">
              Check my latest talks.
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">Let's talk, one on one</h2>
          <p>
            I do one-on-one sessions through ADPList. I see them as a two-way discussion more than
            mentoring: I may not always be more experienced than you, but I am happy to share my
            view. I like talking about careers and productivity as a software engineer, and I am
            open to technical chats about the web too.{' '}
            <a
              href="https://dub.sh/mzp.adp"
              target="_blank"
              rel="me noreferrer noopener"
              title="ADPList"
              class="link-key"
            >
              Check my ADPList profile.
            </a>
          </p>
        </PaperCard>
        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">What I build in public</h2>
          <p>
            I build things for fun and to try new ideas, and I share them. I contribute to and
            maintain community projects like PHPID, React.js ID and KawalCovid19. After 11+ years in
            frontend, giving back is what I enjoy most.{' '}
            <a
              href={AUTHOR_GITHUB}
              target="_blank"
              rel="me noreferrer noopener"
              title="GitHub"
              class="link-key"
            >
              Check my public code
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" class="space-y-3">
          <h2 class="b-h2 mt-0">Where I've worked</h2>
          <p>
            From Java desktop apps to flight booking at Wego, with Blibli, Tokopedia and GovTech Edu
            along the way. I put the whole story on a road trip.{' '}
            <a href={ROUTES.RESUME} class="link-key">
              See my resume
            </a>
          </p>
        </PaperCard>

        <PaperCard as="section" tape class="space-y-3">
          <h2 class="b-h2 mt-0">Want to work together?</h2>

          <div class="flex flex-col items-start gap-2">
            {PROFILE.AVAILABLE_FOR_HIRE && (
              <div class="flex items-center gap-2">
                <span class="relative flex h-3 w-3">
                  <span class="bg-primary absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"></span>
                  <span class="bg-primary relative inline-flex h-3 w-3 rounded-full"></span>
                </span>
                <span class="text-primary">Available for hire</span>
              </div>
            )}
            <Button
              element="a"
              colors="primary"
              variant="solid"
              href={`mailto:${AUTHOR_EMAIL}`}
              target="_blank"
              rel="me noreferrer noopener"
              title="Email"
            >
              Send me an email
            </Button>
            <small>
              Or copy this email manually: <code class="font-mono">{AUTHOR_EMAIL}</code>
            </small>
          </div>
        </PaperCard>
      </div>
      <div class="flex items-center justify-center md:min-w-[300px]">
        <PolaroidCard as="div" class="w-[300px] max-w-full">
          <Image
            slot="photo"
            width={300}
            densities={[1, 2]}
            src={MeInBlackSrc}
            alt="Irfan Maulana, smiling, arms crossed, in a black t-shirt"
            class="w-full"
          />
        </PolaroidCard>
      </div>
    </div>
  </article>
</Centered>
<script type="application/ld+json" set:html={schema} />
