---
import Centered from '@/layouts/Centered.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Button from '@/components/Button.astro';
import Tag from '@/components/Tag.astro';
import { BreadcrumbItemHome } from '@/constants/breadcrumb';
import { CAREERS } from '@/constants/career';
import { CONFIG_CLIENT } from '@/config/client';
import { getPageMetadata } from '@/utils/metadata';

const { AUTHOR_EMAIL } = CONFIG_CLIENT;

const metadata = getPageMetadata('pages/resume');
const breadcrumbs = [BreadcrumbItemHome];
---

<Centered {metadata}>
  <article class="flex flex-col">
    <Breadcrumbs items={breadcrumbs} />
    <slot name="heading">
      <h1 class="b-h1 tracking-wide">{metadata.title}</h1>
    </slot>
    <section class="flex flex-grow flex-col gap-4">
      <p>
        Web developer with extensive experience in building projects from the ground up, enhancing
        performance and scalability of the web, managing several tech stack migrations, promoting
        quality-focused practices, and mentoring junior developers. Focused in frontend technologies
        using Next.js, React.js and TypeScript.
      </p>
      <div class="flex flex-col items-start gap-2">
        <div class="flex flex-wrap items-center gap-2">
          <span class="relative flex h-3 w-3">
            <span class="bg-primary absolute inline-flex h-full w-full animate-ping rounded-full opacity-75"></span>
            <span class="bg-primary relative inline-flex h-3 w-3 rounded-full"></span>
          </span>
          <span class="text-primary">Available for hire</span>
        </div>
        <Button
          element="a"
          colors="primary"
          variant="solid"
          href={`mailto:${AUTHOR_EMAIL}`}
          target="_blank"
          rel="me noreferrer noopener"
          title="Email"
        >
          Send me an email
        </Button>
        <small>
          Or copy this email manually: <code class="font-mono">{AUTHOR_EMAIL}</code>
        </small>
      </div>

      <div class="sheet mt-10">
        <ol class="border-primary relative ms-3 flex flex-col items-start gap-8 border-s-2">
          {CAREERS.map((c) => (
            <li class="ms-8">
              {!c.promotion && <div class="bead absolute -start-3.5 mt-1 h-7 w-7" />}

              <time class="mt-1 mb-1 block text-sm leading-none font-normal text-captions">
                {c.period}&nbsp;&nbsp;•&nbsp;&nbsp;{c.long}
              </time>
              <span class="mb-1 block text-sm leading-none font-normal text-captions">
                {c.location}
              </span>
              <h2 class="mb-2 text-lg font-semibold text-headings">
                {c.title} @ {c.company}
              </h2>
              <p class="mb-4 text-base font-normal text-captions">{c.summary}</p>

              <div class="flex flex-wrap items-center gap-2">
                {c.stacks.map((stack) => (
                  <Tag size="sm">{stack}</Tag>
                ))}
              </div>
            </li>
          ))}
        </ol>
      </div>
    </section>
  </article>
</Centered>
