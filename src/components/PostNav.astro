---
import { ROUTES } from '@/constants/routes';

import type { Post } from '@/types/post';

export interface Props {
  /** older post */
  prev?: Post;
  /** newer post */
  next?: Post;
}

const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav aria-label="More posts" class="post-nav my-8 grid gap-6 sm:grid-cols-2">
    <div>
      {prev && (
        <a href={`${ROUTES.BLOG}/${prev.slug}`} class="nav-card">
          <span class="keycap keycap-navy keycap-nav keycap-nav-icon shrink-0" aria-hidden="true">
            <span class="keycap-face">&larr;</span>
          </span>
          <span class="min-w-0">
            <span class="block text-sm">Older post</span>
            <span class="block font-bold">{prev.data.title}</span>
          </span>
        </a>
      )}
    </div>
    <div>
      {next && (
        <a href={`${ROUTES.BLOG}/${next.slug}`} class="nav-card nav-card-next">
          <span class="keycap keycap-navy keycap-nav keycap-nav-icon shrink-0" aria-hidden="true">
            <span class="keycap-face">&rarr;</span>
          </span>
          <span class="min-w-0">
            <span class="block text-sm">Newer post</span>
            <span class="block font-bold">{next.data.title}</span>
          </span>
        </a>
      )}
    </div>
  </nav>
)}
