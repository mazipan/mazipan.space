---
import { Icon } from 'astro-icon/components';

import NavKey from '@/components/NavKey.astro';
import { CONFIG_CLIENT } from '@/config/client';

const {
  AUTHOR_LINKEDIN,
  AUTHOR_GITHUB,
  AUTHOR_TWITTER,
  AUTHOR_YOUTUBE,
  // eslint-disable-next-line no-unused-vars
  AUTHOR_ADPLIST,
  // eslint-disable-next-line no-unused-vars
  AUTHOR_DECK,
  AUTHOR_EMAIL,
} = CONFIG_CLIENT;
---

<ul class="flex flex-wrap gap-2 lg:items-center">
  <li>
    <NavKey
      element="a"
      href={`mailto:${AUTHOR_EMAIL}`}
      target="_blank"
      rel="me noreferrer noopener"
      aria-label="Email"
      title="Email"
      colors="cream"
      icon
      round
    >
      <Icon name="tabler:mail" class="h-6 w-6" aria-hidden="true" />
    </NavKey>
  </li>
  <li>
    <NavKey
      element="a"
      href={AUTHOR_GITHUB}
      target="_blank"
      rel="me noreferrer noopener"
      aria-label="GitHub"
      title="GitHub"
      colors="cream"
      icon
      round
    >
      <Icon name="tabler:brand-github" class="h-6 w-6" aria-hidden="true" />
    </NavKey>
  </li>
  <li>
    <NavKey
      element="a"
      href={AUTHOR_TWITTER}
      target="_blank"
      rel="me noreferrer noopener"
      aria-label="Twitter/X"
      title="Twitter/X"
      colors="cream"
      icon
      round
    >
      <Icon name="tabler:brand-x" class="h-6 w-6" aria-hidden="true" />
    </NavKey>
  </li>
  <li>
    <NavKey
      element="a"
      href={AUTHOR_LINKEDIN}
      target="_blank"
      rel="me noreferrer noopener"
      aria-label="LinkedIn"
      title="LinkedIn"
      colors="cream"
      icon
      round
    >
      <Icon name="tabler:brand-linkedin" class="h-6 w-6" aria-hidden="true" />
    </NavKey>
  </li>
  <li>
    <NavKey
      element="a"
      href={AUTHOR_YOUTUBE}
      target="_blank"
      rel="me noreferrer noopener"
      aria-label="YouTube"
      title="YouTube"
      colors="cream"
      icon
      round
    >
      <Icon name="tabler:brand-youtube" class="h-6 w-6" aria-hidden="true" />
    </NavKey>
  </li>
</ul>
