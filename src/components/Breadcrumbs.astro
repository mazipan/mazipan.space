---
import { CONFIG_CLIENT } from '@/config/client';
import { cn } from '@/utils/styles';

import type { HTMLAttributes } from 'astro/types';

const { SITE_URL } = CONFIG_CLIENT;

export interface BreadcrumbItem {
  href: string;
  text: string;
}

export interface Props extends HTMLAttributes<'nav'> {
  items: BreadcrumbItem[];
}

const { items, ...props } = Astro.props;

const schema = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: items.map((item, index) => {
    return {
      '@type': 'ListItem',
      position: index + 1,
      name: item.text,
      item: SITE_URL + item.href,
    };
  }),
});
---

<nav class={cn('my-3')} aria-label="breadcrumb" {...props}>
  <div class="relative flex flex-wrap items-center gap-3 pb-1">
    {items.map((item) => (
      <a
        href={item.href}
        title={item.text}
        class="crumb focus-visible:outline-primary no-underline hover:no-underline focus-visible:outline-2 focus-visible:outline-offset-2"
      >
        {item.text}
      </a>
    ))}
  </div>
</nav>
<script type="application/ld+json" set:html={schema} />
