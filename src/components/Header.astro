---
import { Icon } from 'astro-icon/components';

import HeaderLink from '@/components/HeaderLink.astro';
import Logo from '@/components/Logo.astro';
import NavKey from '@/components/NavKey.astro';
import ThemePopover from '@/components/ThemePopover.astro';
import { SELECTORS } from '@/constants/dom';
import { NAVIGATION_ITEMS } from '@/constants/navigation';
import { ROUTES } from '@/constants/routes';
import { getActiveNavItemPath } from '@/utils/navigation';
import { cn } from '@/utils/styles';

const { SCROLL_TO_TOP_ID } = SELECTORS;
// each menu key gets its own color, the label is always text
const KEY_TONES = ['terracotta', 'teal', 'mustard', 'navy'] as const;

const { pathname: routePathname } = Astro.url;
const activeNavItemPath = getActiveNavItemPath(routePathname);
// the key of the page itself is `page`, the key of a section the page belongs to is `true`
const currentOf = (path: string) =>
  routePathname.replace(/\/+$/, '') === path ? ('page' as const) : ('true' as const);
---

<header
  id={SCROLL_TO_TOP_ID}
  data-menu="close"
  class="group fixed top-2 z-50 w-full px-4 py-2 lg:px-0"
>
  <div class="header-slab relative max-w-6xl md:mx-auto">
    <div
      class={cn(
        'header-slab-face relative flex gap-2',
        'md:!flex-row md:items-center md:justify-between',
        'px-4 py-2'
      )}
    >
      {/* mobile nav */}
      <div class="flex w-full items-center justify-between md:w-auto">
        <HeaderLink
          href={ROUTES.HOME}
          aria-label="Home"
          isActive={routePathname === ROUTES.HOME}
          class="logo-link focus:ring-primary flex items-center rounded-lg px-1 py-1 focus:ring-2 focus:ring-offset-2 focus:outline-none"
        >
          <Logo />
        </HeaderLink>

        <mobile-button class="flex items-center gap-2 md:hidden">
          <ThemePopover id="theme-popover-mobile" />
          <NavKey
            id="menu-toggle"
            colors="terracotta"
            icon
            element="button"
            aria-expanded="false"
            aria-haspopup="menu"
            aria-label="Open main menu"
            class="group"
          >
            <Icon name="tabler:menu-3" class="h-6 w-6 group-aria-expanded:hidden" />
            <Icon name="tabler:menu-deep" class="hidden h-6 w-6 group-aria-expanded:block" />
          </NavKey>
        </mobile-button>
      </div>

      {/* Desktop nav items */}
      <nav class="mt-0 hidden select-none md:block" aria-label="Site navigation">
        <ul class="flex gap-2 md:!flex-row md:items-center">
          {NAVIGATION_ITEMS.map(({ title, path }, index) => (
            <li class="relative">
              <NavKey
                lamp
                element="a"
                href={path}
                colors={KEY_TONES[index % KEY_TONES.length]}
                size="sm"
                pressed={path === activeNavItemPath}
                current={currentOf(path)}
              >
                {title}
              </NavKey>
            </li>
          ))}
          <li class="shrink-0">
            <ThemePopover id="theme-popover-desktop" />
          </li>
        </ul>
      </nav>
    </div>
  </div>
</header>

<aside class="group relative md:hidden" data-menu="close" id="menu-mobile">
  {/* Mobile nav items */}
  <nav
    class="sheet fixed top-[var(--header-h)] right-4 z-20 min-w-[200px] transform !p-3 transition-all duration-500 select-none group-[[data-menu=close]]:invisible group-[[data-menu=close]]:translate-x-[110%] group-[[data-menu=open]]:translate-x-0 md:hidden"
    aria-label="Site navigation"
  >
    <ul class="flex flex-col gap-2">
      {NAVIGATION_ITEMS.map(({ title, path }, index) => (
        <li class="relative">
          <NavKey
            lamp
            element="a"
            href={path}
            colors={KEY_TONES[index % KEY_TONES.length]}
            size="sm"
            class="w-full"
            pressed={path === activeNavItemPath}
            current={currentOf(path)}
          >
            {title}
          </NavKey>
        </li>
      ))}
    </ul>
  </nav>
</aside>

<script>
  class MobileNavBtn extends HTMLElement {
    private headerEl: HTMLElement;
    private mobileNav: HTMLElement;
    private menuOpen: boolean;
    private mobileButtonEl: HTMLButtonElement;

    toggleMobileMenu = () => {
      // SCROLL_TO_TOP_ID
      const prevState = this.mobileNav.getAttribute('data-menu');
      const nextState = prevState === 'open' ? 'close' : 'open';

      this.mobileNav.setAttribute('data-menu', nextState);
      this.headerEl.setAttribute('data-menu', nextState);

      this.menuOpen = !this.menuOpen;
      this.mobileButtonEl.setAttribute('aria-expanded', this.menuOpen.toString());
    };

    constructor() {
      super();
      this.headerEl = document.getElementById('main-header')!;
      this.mobileNav = document.getElementById('menu-mobile')!;
      this.mobileButtonEl = this.querySelector('#menu-toggle') as HTMLButtonElement;
      this.menuOpen = false;

      this.mobileButtonEl.addEventListener('click', this.toggleMobileMenu);
    }
  }

  customElements.define('mobile-button', MobileNavBtn);
</script>
