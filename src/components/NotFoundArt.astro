<style>
  .notfound-art {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  /* Without motion (reduced motion) the picture is one still frame: the key is out of the slot,
     the arm is up, the sleeping cat shows its Zs and the cat says "!". */
  .nf-key {
    transform-origin: 250px 90px;
    transform: translate(12px, 0) rotate(-9deg);
  }
  .nf-arm {
    transform-origin: 352.5px 97.5px;
  }

  /* one 12s loop: the key sits in the slot, the cat lifts it (arm up, key out), finds the sleeping
     cat ("!", Zs), then puts the key back in the slot. All the parts share the same timing. */
  @media (prefers-reduced-motion: no-preference) {
    .nf-key,
    .nf-arm,
    .nf-bang,
    .nf-lines,
    .nf-cat2 .nf-zzz {
      animation-duration: 12s;
      animation-iteration-count: infinite;
      animation-timing-function: ease-in-out;
    }
    .nf-key {
      animation-name: nf-key;
    }
    .nf-arm {
      animation-name: nf-arm;
    }
    .nf-bang {
      animation-name: nf-bang;
    }
    .nf-lines {
      animation-name: nf-lines;
    }
    .nf-cat2 .nf-zzz {
      animation-name: nf-zzz;
    }
  }
  @keyframes nf-key {
