---
// The 404 picture: a row of keys reading 4 0 4. A ginger cat has batted the 0 key out of its slot
// and a dark cat is asleep in the gap. Drawn with the palette tokens, so it follows the chosen palette in light and dark.
// Decorative (the headline says it all), so it is hidden from screen readers.
---

<svg
  class="notfound-art"
  viewBox="0 0 500 270"
  role="presentation"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient id="nf-terracotta" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--th-key-terracotta-face-hi)"></stop>
      <stop offset="1" style="stop-color: var(--th-key-terracotta-face-lo)"></stop>
    </linearGradient>
    <linearGradient id="nf-teal" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--th-key-teal-face-hi)"></stop>
      <stop offset="1" style="stop-color: var(--th-key-teal-face-lo)"></stop>
    </linearGradient>
    <linearGradient id="nf-wood" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--th-wood-hi)"></stop>
      <stop offset="1" style="stop-color: var(--th-wood-lo)"></stop>
    </linearGradient>
  </defs>

  <!-- the tray the keys sit in -->
  <rect
    x="6"
    y="112"
    width="488"
    height="150"
    rx="22"
    fill="url(#nf-wood)"
    stroke="var(--th-key-edge)"
    stroke-width="3"
  ></rect>
  <rect x="6" y="112" width="488" height="10" rx="5" fill="#fff" fill-opacity=".18"></rect>

  <!-- the empty slot: sunken, with a dark inside -->
  <rect
    x="186"
    y="142"
    width="128"
    height="104"
    rx="16"
    style="fill: var(--th-key-cream-side)"
    opacity=".55"
  ></rect>
  <rect
    x="186"
    y="142"
    width="128"
    height="104"
    rx="16"
    fill="none"
    stroke="var(--th-key-edge)"
    stroke-width="3"
    stroke-dasharray="9 7"
  ></rect>

  <!-- ginger cat behind the right key, batting at the floating 0 -->
  <g class="nf-cat1" stroke-linejoin="round" stroke-linecap="round">
    <path
      d="M424 118 Q384 118 332 80"
      fill="none"
      stroke="var(--th-key-edge)"
      stroke-width="23"
    ></path>
    <path
      d="M424 118 Q384 118 332 80"
      fill="none"
      style="stroke: var(--th-key-mustard-face-lo)"
      stroke-width="17"
    ></path>
    <path
      d="M410 80 L414 54 L430 69 Z"
      style="fill: var(--th-key-mustard-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></path>
    <path
      d="M436 69 L452 54 L457 82 Z"
      style="fill: var(--th-key-mustard-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></path>
    <path d="M416 74 L418 63 L425 70 Z" style="fill: var(--th-key-terracotta-face-hi)"></path>
    <path d="M441 70 L449 63 L451 75 Z" style="fill: var(--th-key-terracotta-face-hi)"></path>
    <ellipse
      cx="433"
      cy="92"
      rx="27"
      ry="24"
      style="fill: var(--th-key-mustard-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></ellipse>
    <path
      d="M427 70 v8 M433 68 v9 M439 70 v8"
      fill="none"
      style="stroke: var(--th-key-mustard-side)"
      stroke-width="3"
    ></path>
    <ellipse cx="423" cy="91" rx="3.6" ry="5.2" fill="#2b1d14"></ellipse>
    <ellipse cx="445" cy="91" rx="3.6" ry="5.2" fill="#2b1d14"></ellipse>
    <circle cx="424.4" cy="89" r="1.3" fill="#fff"></circle>
    <circle cx="446.4" cy="89" r="1.3" fill="#fff"></circle>
    <path d="M430.5 99 h7 l-3.5 4 Z" style="fill: var(--th-key-terracotta-face-hi)"></path>
    <path
      d="M434 103 v3 M434 106 q-4 4 -8 1 M434 106 q4 4 8 1"
      fill="none"
      stroke="var(--th-key-edge)"
      stroke-width="2"
    ></path>
    <path
      d="M411 98 l-15 -3 M411 103 l-15 3 M456 98 l15 -3 M456 103 l15 3"
      fill="none"
      stroke="var(--th-key-edge)"
      stroke-width="2"
    ></path>
    <ellipse
      cx="333"
      cy="79"
      rx="9"
      ry="8"
      style="fill: var(--th-key-mustard-face-hi)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></ellipse>
    <path
      d="M330 75 v-1 M335 74 v-1 M339 77 v-1"
      fill="none"
      stroke="var(--th-key-edge)"
      stroke-width="2"
    ></path>
  </g>

  <!-- left 4 -->
  <g>
    <rect
      x="30"
      y="138"
      width="124"
      height="110"
      rx="18"
      style="fill: var(--th-key-terracotta-side)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></rect>
    <rect
      x="34"
      y="130"
      width="116"
      height="94"
      rx="15"
      fill="url(#nf-terracotta)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></rect>
    <path
      d="M46 142 Q92 134 138 142"
      stroke="#fff"
      stroke-opacity=".35"
      stroke-width="4"
      stroke-linecap="round"
      fill="none"
    ></path>
    <path
      d="M108 152 V206 M108 152 L68 188 H122"
      style="stroke: var(--th-key-terracotta-text)"
      stroke-width="10"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    ></path>
  </g>

  <!-- right 4 -->
  <g transform="translate(316 0)">
    <rect
      x="30"
      y="138"
      width="124"
      height="110"
      rx="18"
      style="fill: var(--th-key-terracotta-side)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></rect>
    <rect
      x="34"
      y="130"
      width="116"
      height="94"
      rx="15"
      fill="url(#nf-terracotta)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></rect>
    <path
      d="M46 142 Q92 134 138 142"
      stroke="#fff"
      stroke-opacity=".35"
      stroke-width="4"
      stroke-linecap="round"
      fill="none"
    ></path>
    <path
      d="M108 152 V206 M108 152 L68 188 H122"
      style="stroke: var(--th-key-terracotta-text)"
      stroke-width="10"
      stroke-linecap="round"
      stroke-linejoin="round"
      fill="none"
    ></path>
  </g>

  <!-- dark cat asleep in the empty slot -->
  <g class="nf-cat2" stroke-linejoin="round" stroke-linecap="round">
    <path
      d="M300 212 Q336 198 326 228 Q320 240 292 238"
      fill="none"
      stroke="var(--th-key-edge)"
      stroke-width="17"
    ></path>
    <path
      d="M300 212 Q336 198 326 228 Q320 240 292 238"
      fill="none"
      style="stroke: var(--th-key-navy-face-lo)"
      stroke-width="11"
    ></path>
    <ellipse
      cx="256"
      cy="214"
      rx="52"
      ry="27"
      style="fill: var(--th-key-navy-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></ellipse>
    <path
      d="M222 198 Q256 186 292 200"
      fill="none"
      stroke="#fff"
      stroke-opacity=".22"
      stroke-width="4"
    ></path>
    <path
      d="M194 202 L195 180 L209 194 Z"
      style="fill: var(--th-key-navy-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></path>
    <path
      d="M211 194 L225 181 L227 201 Z"
      style="fill: var(--th-key-navy-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></path>
    <circle
      cx="211"
      cy="210"
      r="20"
      style="fill: var(--th-key-navy-face-lo)"
      stroke="var(--th-key-edge)"
      stroke-width="3"
    ></circle>
    <path
      d="M201 209 q4 4 8 0 M214 209 q4 4 8 0"
      fill="none"
      style="stroke: var(--th-key-navy-text)"
      stroke-width="2.5"
    ></path>
    <circle cx="211.5" cy="216" r="2" style="fill: var(--th-key-terracotta-face-hi)"></circle>
    <g class="nf-zzz" fill="none" stroke="var(--th-key-edge)" stroke-width="3">
      <path d="M262 178 h11 l-11 13 h11"></path>
      <path d="M282 160 h8 l-8 10 h8"></path>
    </g>
  </g>

  <!-- the 0 that popped out, floating and tilted -->
  <g class="nf-float">
    <g transform="rotate(-9 250 90)">
      <rect
        x="188"
        y="26"
        width="124"
        height="110"
        rx="18"
        style="fill: var(--th-key-teal-side)"
        stroke="var(--th-key-edge)"
        stroke-width="3"
      ></rect>
      <rect
        x="192"
        y="18"
        width="116"
        height="94"
        rx="15"
        fill="url(#nf-teal)"
        stroke="var(--th-key-edge)"
        stroke-width="3"
      ></rect>
      <path
        d="M204 30 Q250 22 296 30"
        stroke="#fff"
        stroke-opacity=".35"
        stroke-width="4"
        stroke-linecap="round"
        fill="none"
      ></path>
      <ellipse
        cx="250"
        cy="66"
        rx="21"
        ry="29"
        style="stroke: var(--th-key-teal-text)"
        stroke-width="10"
        fill="none"
      ></ellipse>
    </g>
    <!-- little motion lines -->
    <g stroke="var(--th-key-edge)" stroke-width="4" stroke-linecap="round" fill="none">
      <path d="M170 70 l-16 -8"></path>
      <path d="M168 94 l-20 0"></path>
    </g>
  </g>
</svg>

<style>
  .notfound-art {
    display: block;
    width: 100%;
    max-width: 30rem;
    height: auto;
    margin-inline: auto;
    overflow: visible;
  }
  .nf-float {
    animation: nf-bob 3.2s ease-in-out infinite;
  }
  .nf-zzz {
    animation: nf-zzz 3.2s ease-in-out infinite;
  }
  @keyframes nf-bob {
    0%,
    100% {
      transform: translateY(0);
    }
    50% {
      transform: translateY(-9px);
    }
  }
  @keyframes nf-zzz {
    0%,
    100% {
      opacity: 0.35;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .nf-float,
    .nf-zzz {
      animation: none;
    }
  }
</style>
