---
import { Icon } from 'astro-icon/components';

type TabItem = string | { id: string; text: string };

interface Props {
  labels: TabItem[];
}

const { labels } = Astro.props;

const tabs = labels.map((item) => (typeof item === 'string' ? { id: item, text: item } : item));

const ICON_MAP: Record<string, string> = {
  npm: 'pm-npm',
  pnpm: 'pm-pnpm',
  yarn: 'pm-yarn',
  bun: 'pm-bun',
};
---

<code-group>
  <div role="tablist" class="code-tabs">
    {tabs.map(({ id, text }, i) => (
      <button
        role="tab"
        type="button"
        data-label={id}
        data-active={i === 0 ? 'true' : 'false'}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
        class="code-tab"
      >
        {ICON_MAP[id] ? (
          <Icon name={ICON_MAP[id]} class="h-[18px] w-[18px]" aria-hidden="true" />
        ) : null}
        <span>{text}</span>
      </button>
    ))}
  </div>
  <div class="panels">
    <slot />
  </div>
</code-group>

<style>
  code-group {
    display: block;
  }

  code-group .panels > :global([data-label]) {
    display: none;
  }

  code-group .panels > :global([data-label][data-active='true']) {
    display: block;
  }
</style>

<script>
  class CodeGroupElement extends HTMLElement {
    private tabs: NodeListOf<HTMLButtonElement>;
    private panels: NodeListOf<HTMLElement>;

    handleTabClick = (e: Event) => {
      const btn = e.currentTarget as HTMLButtonElement;
      const label = btn.dataset.label;

      this.tabs.forEach((tab) => {
        const isActive = tab === btn;
        tab.dataset.active = isActive ? 'true' : 'false';
        tab.setAttribute('aria-selected', isActive ? 'true' : 'false');
        tab.tabIndex = isActive ? 0 : -1;
      });

      this.panels.forEach((panel) => {
        panel.dataset.active = panel.dataset.label === label ? 'true' : 'false';
      });
    };

    // arrow keys, Home and End move between the tabs (the tabs are one tab stop)
    handleKeydown = (e: KeyboardEvent) => {
      const keys = ['ArrowLeft', 'ArrowRight', 'Home', 'End'];
      if (!keys.includes(e.key)) return;
      const list = [...this.tabs];
      const current = list.indexOf(e.currentTarget as HTMLButtonElement);
      let next = current;
      if (e.key === 'ArrowRight') next = (current + 1) % list.length;
      if (e.key === 'ArrowLeft') next = (current - 1 + list.length) % list.length;
      if (e.key === 'Home') next = 0;
      if (e.key === 'End') next = list.length - 1;
      e.preventDefault();
      list[next].focus();
      list[next].click();
    };

    constructor() {
      super();
      this.tabs = this.querySelectorAll<HTMLButtonElement>('[role="tablist"] [role="tab"]');
      this.panels = this.querySelectorAll<HTMLElement>('.panels [data-label]');
    }

    connectedCallback() {
      // Show first panel, hide others
      this.panels.forEach((panel, i) => {
        panel.dataset.active = i === 0 ? 'true' : 'false';
      });

      this.tabs.forEach((tab) => {
        tab.addEventListener('click', this.handleTabClick);
        tab.addEventListener('keydown', this.handleKeydown);
      });
    }

    disconnectedCallback() {
      this.tabs.forEach((tab) => {
        tab.removeEventListener('click', this.handleTabClick);
        tab.removeEventListener('keydown', this.handleKeydown);
      });
    }
  }

  customElements.define('code-group', CodeGroupElement);
</script>
