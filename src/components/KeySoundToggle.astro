---
// Opt-in key click sound. Off by default, the choice is remembered in localStorage.
// Lives in the appearance popover; there can be more than one instance on a page.
import NavKey from './NavKey.astro';
---

<key-sound-toggle>
  <NavKey element="button" colors="cream" pressed={false} data-key-sound tight lamp class="w-full">
    <span data-label>Key sounds: off</span>
  </NavKey>
</key-sound-toggle>

<script>
  const STORAGE_KEY = 'key-sound';

  const read = () => {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'on';
    } catch {
      return false;
    }
  };

  const write = (on: boolean) => {
    try {
      localStorage.setItem(STORAGE_KEY, on ? 'on' : 'off');
    } catch {
      // private mode: the choice just is not remembered
    }
  };

  let enabled = read();
  let ctx: AudioContext | undefined;

  // a short filtered noise burst, like a switch clicking
  const click = (volume: number, freq: number) => {
    if (!enabled) return;
    try {
      ctx ??= new AudioContext();
      const length = Math.floor(ctx.sampleRate * 0.04);
      const buffer = ctx.createBuffer(1, length, ctx.sampleRate);
      const data = buffer.getChannelData(0);
      for (let i = 0; i < length; i++)
        data[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / length, 6);
      const source = ctx.createBufferSource();
      source.buffer = buffer;
      const filter = ctx.createBiquadFilter();
      filter.type = 'bandpass';
      filter.frequency.value = freq;
      filter.Q.value = 1.2;
      const gain = ctx.createGain();
      gain.gain.value = volume;
      source.connect(filter);
      filter.connect(gain);
      gain.connect(ctx.destination);
      source.start();
    } catch {
      // audio not available: stay silent
    }
  };

  const isKey = (target: EventTarget | null) => {
    const key = (target as HTMLElement | null)?.closest?.('.keycap');
    return key && !key.hasAttribute('disabled') && key.getAttribute('aria-disabled') !== 'true';
  };

  // listeners are added once for the whole page, they survive view transitions
  const w = window as unknown as { __keySound?: boolean };
  if (!w.__keySound) {
    w.__keySound = true;
    document.addEventListener('pointerdown', (e) => isKey(e.target) && click(0.9, 1800));
    document.addEventListener('pointerup', (e) => isKey(e.target) && click(0.5, 2600));
    document.addEventListener('keydown', (e) => {
      if ((e.key === 'Enter' || e.key === ' ') && isKey(e.target)) click(0.9, 1800);
    });
  }

  class KeySoundToggle extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>('[data-key-sound]');
      const label = this.querySelector('[data-label]');
      if (!button || !label) return;
      enabled = read();
      const render = () => {
        button.setAttribute('aria-pressed', String(enabled));
        label.textContent = `Key sounds: ${enabled ? 'on' : 'off'}`;
      };
      render();
      button.addEventListener('click', () => {
        enabled = !enabled;
        write(enabled);
        // every instance on the page shows the same state
        document.querySelectorAll('key-sound-toggle').forEach((el) => {
          el.querySelector('[data-key-sound]')?.setAttribute('aria-pressed', String(enabled));
          const l = el.querySelector('[data-label]');
          if (l) l.textContent = `Key sounds: ${enabled ? 'on' : 'off'}`;
        });
        // the toggle's own click is the first sound after switching on
        click(0.9, 1800);
      });
    }
  }

  if (!customElements.get('key-sound-toggle'))
    customElements.define('key-sound-toggle', KeySoundToggle);
</script>
