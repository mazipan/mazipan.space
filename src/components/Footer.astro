---
import { Icon } from 'astro-icon/components';

import Link from '@/components/Link.astro';
import { ROUTES } from '@/constants/routes';
import { CONFIG_CLIENT } from '@/config/client';
import { getLatestCommitInfo } from '@/libs/git';
import { shortDate } from '@/utils/datetime';
import { limitString, trimHttpProtocol } from '@/utils/strings';
import Logo from './Logo.astro';
import NavKey from './NavKey.astro';
import SocialLinks from './SocialLinks.astro';

const { SITE_URL, REPO_URL, AUTHOR_ADPLIST, AUTHOR_DECK } = CONFIG_CLIENT;

const domain = trimHttpProtocol(SITE_URL);
const messageLength = 20 as const;

const { time, fullHash, message } = getLatestCommitInfo();

const commitUrl = `${REPO_URL}/commit/${fullHash}`;

const shortDateStr = shortDate(new Date(time));
const trimmedMessage = limitString(message, messageLength);
const copyrightYear = new Date().getFullYear();

// footer is full width for border, div has max-w
---

<footer class="footer-plank px-4 pt-10 pb-6">
  <div class="max-w-6xl md:mx-auto">
    <div class="footer-deck">
      <div class="footer-brand">
        <div class="flex items-center gap-3">
          <Logo id="footer-logo-key" />
          <div>
            <p class="m-0 font-serif text-xl leading-tight font-bold">Irfan Maulana</p>
            <p class="text-captions m-0 text-sm">Web developer, writer, speaker.</p>
          </div>
        </div>
        <SocialLinks />
        <div>
          <h2 class="footer-label">Older versions</h2>
          <div class="flex flex-wrap gap-3">
            <a
              href="https://2026.mazipan.space/"
              target="_blank"
              rel="me noreferrer noopener"
              title="2026 Version"
              class="crumb"
            >
              2026
            </a>
            <a
              href="https://2024.mazipan.space/"
              target="_blank"
              rel="me noreferrer noopener"
              title="2024 Version"
              class="crumb"
            >
              2024
            </a>
          </div>
        </div>
      </div>

      <div class="footer-cols">
        <nav aria-labelledby="footer-site">
          <h2 id="footer-site" class="footer-label">
            Site
          </h2>
          <ul class="footer-links">
            <li>
              <Link href={ROUTES.BLOG}>Blog</Link>
            </li>
            <li>
              <Link href={ROUTES.CAROUSEL}>Slides</Link>
            </li>
            <li>
              <Link href={ROUTES.EXPLORE}>Explore</Link>
            </li>
            <li>
              <Link href={ROUTES.PROJECTS}>Projects</Link>
            </li>
            <li>
              <Link href={ROUTES.ABOUT}>About</Link>
            </li>
          </ul>
        </nav>
        <nav aria-labelledby="footer-more-pages">
          <h2 id="footer-more-pages" class="footer-label">
            More pages
          </h2>
          <ul class="footer-links">
            <li>
              <Link href={ROUTES.TALKS}>Talks</Link>
            </li>
            <li>
              <Link href={ROUTES.SUPPORT}>Support</Link>
            </li>
            <li>
              <Link href={ROUTES.RESUME}>Resume</Link>
            </li>
            <li>
              <Link href={ROUTES.CREDITS}>Credits</Link>
            </li>
            <li>
              <Link href={ROUTES.FRIENDS}>Friends</Link>
            </li>
            <li>
              <Link href={ROUTES.GUEST_BOOK}>Guest Book</Link>
            </li>
          </ul>
        </nav>
        <nav aria-labelledby="footer-elsewhere">
          <h2 id="footer-elsewhere" class="footer-label">
            Elsewhere
          </h2>
          <ul class="footer-links">
            <li>
              <Link
                href={ROUTES.BOOKMARKS}
                target="_blank"
                rel="me noreferrer noopener"
                title="Bookmark collections"
              >
                Bookmarks
              </Link>
            </li>
            <li>
              <Link
                href={ROUTES.TOOLS}
                target="_blank"
                rel="me noreferrer noopener"
                title="Tools collections"
              >
                Tools
              </Link>
            </li>
            <li>
              <Link
                href={ROUTES.GAMES}
                target="_blank"
                rel="me noreferrer noopener"
                title="Games collections"
              >
                Games
              </Link>
            </li>
            <li>
              <Link
                href={AUTHOR_ADPLIST}
                title="Meet me at ADPList"
                target="_blank"
                rel="me noreferrer noopener"
              >
                One on one
              </Link>
            </li>
            <li>
              <Link
                href={AUTHOR_DECK}
                title="Presentation Decks"
                target="_blank"
                rel="me noreferrer noopener"
              >
                Decks
              </Link>
            </li>
            <li>
              <Link
                href={ROUTES.UMAMI_PUBLIC_URL}
                title="Analytics"
                target="_blank"
                rel="me noreferrer noopener"
              >
                Analytics
              </Link>
            </li>
            <li>
              <Link
                href={ROUTES.GH_NEW_ISSUE}
                target="_blank"
                rel="me noreferrer noopener"
                title="Report an issue"
              >
                Report an issue
              </Link>
            </li>
            <li>
              <Link
                href={ROUTES.API.FEED_RSS}
                target="_blank"
                rel="me noreferrer noopener"
                title={`RSS feed for ${domain}`}
              >
                RSS
              </Link>
            </li>
          </ul>
        </nav>
      </div>
    </div>

    <div class="footer-plate bg-nodes">
      <div class="footer-plate-text">
        <p class="m-0">© 2019-{copyrightYear} Irfan Maulana</p>
        <p class="m-0">
          <span class="text-primary">v{process.env.APP_VERSION}</span>, deployed at{' '}
          {process.env.APP_DEPLOY_AT}
        </p>
        <p class="m-0">
          Latest change:{' '}
          <Link href={commitUrl} title={shortDateStr} target="_blank" rel="noreferrer noopener">
            {trimmedMessage}
          </Link>
        </p>
      </div>
      <scroll-to-top-button>
        <NavKey
          element="button"
          colors="terracotta"
          icon
          round
          id="btn-scroll-to-top"
          aria-label="Back to top"
        >
          <Icon name="tabler:arrow-up" class="h-5 w-5" aria-hidden="true" />
        </NavKey>
      </scroll-to-top-button>
    </div>
  </div>
</footer>

<script>
  class ScrollToTop extends HTMLElement {
    private btnEl: HTMLButtonElement;

    scrollMeToTheTop = () => {
      window.scrollTo({
        top: 0,
        behavior: 'smooth',
      });
    };

    constructor() {
      super();
      this.btnEl = this.querySelector('#btn-scroll-to-top') as HTMLButtonElement;
      this.btnEl.addEventListener('click', this.scrollMeToTheTop);
    }
  }

  customElements.define('scroll-to-top-button', ScrollToTop);
</script>
