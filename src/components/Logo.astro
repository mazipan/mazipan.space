---
// MZP as three bevelled keycaps (same drawing as public/logo.svg and the favicon). The key colors
// are the palette tokens, so the logo follows the chosen palette. Decorative: the link around it
// carries the name. Hover or focus on the link presses the keys in one after another, like typing.
const keys = [
  { tone: 'terracotta', x: 0, legend: 'M19 39 V16 L32 30 L45 16 V39' },
  { tone: 'teal', x: 74, legend: 'M20 17 H44 L20 39 H44' },
  { tone: 'mustard', x: 148, legend: 'M22 40 V16 H35 A8 8 0 0 1 35 32 H22' },
] as const;
---

<svg class="logo-keys" viewBox="0 0 212 64" height="40" aria-hidden="true" focusable="false">
  <defs>
    {keys.map(({ tone }) => (
      <linearGradient id={`logo-key-${tone}`} x1="0" y1="0" x2="0" y2="1">
        <stop offset="0" style={`stop-color: var(--th-key-${tone}-face-hi)`}></stop>
        <stop offset="1" style={`stop-color: var(--th-key-${tone}-face-lo)`}></stop>
      </linearGradient>
    ))}
  </defs>
  {keys.map(({ tone, x, legend }, i) => (
    <g transform={`translate(${x} 0)`} style={`--i: ${i}`}>
      <rect
        x="3"
        y="7"
        width="58"
        height="54"
        rx="14"
        style={`fill: var(--th-key-${tone}-side)`}
        stroke="var(--th-key-edge)"
        stroke-width="2"
      />
      <g class="logo-key-face">
        <rect
          x="5"
          y="4"
          width="54"
          height="46"
          rx="12"
          fill={`url(#logo-key-${tone})`}
          stroke="var(--th-key-edge)"
          stroke-width="2"
        />
        <path
          d="M11 13.5 Q32 8 53 13.5"
          stroke="#fff"
          stroke-opacity=".38"
          stroke-width="3"
          stroke-linecap="round"
          fill="none"
        />
        <path
          d={legend}
          style={`stroke: var(--th-key-${tone}-text)`}
          stroke-width="7"
          stroke-linecap="round"
          stroke-linejoin="round"
          fill="none"
        />
      </g>
    </g>
  ))}
</svg>
