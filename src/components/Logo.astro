---
// MZP on ONE square keycap: the same drawing as public/logo.svg and the favicon. The key colors are
// the palette tokens, so the logo follows the chosen palette. Decorative: the link around it carries
// the name. Hover or focus on the link presses the key in.
const { id = 'logo-key-face' } = Astro.props;
const legend = [
  'M11 36 V18 L18 28 L25 18 V36',
  'M28.5 18 H39.5 L28.5 36 H39.5',
  'M42 36 V18 H48 A4.5 4.5 0 0 1 48 27 H42',
];
---

<svg
  class="logo-keys"
  viewBox="0 0 64 64"
  width="40"
  height="40"
  aria-hidden="true"
  focusable="false"
>
  <defs>
    <linearGradient {id} x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" style="stop-color: var(--th-key-terracotta-face-hi)"></stop>
      <stop offset="1" style="stop-color: var(--th-key-terracotta-face-lo)"></stop>
    </linearGradient>
  </defs>
  <rect
    x="3"
    y="7"
    width="58"
    height="54"
    rx="14"
    style="fill: var(--th-key-terracotta-side)"
    stroke="var(--th-key-edge)"
    stroke-width="2"
  ></rect>
  <g class="logo-key-face">
    <rect
      x="5"
      y="4"
      width="54"
      height="46"
      rx="12"
      fill={`url(#${id})`}
      stroke="var(--th-key-edge)"
      stroke-width="2"
    ></rect>
    <path
      d="M11 13 Q32 8 53 13"
      stroke="#fff"
      stroke-opacity=".38"
      stroke-width="2.5"
      stroke-linecap="round"
      fill="none"
    ></path>
    {legend.map((d) => (
      <path
        d={d}
        style="stroke: var(--th-key-terracotta-text)"
        stroke-width="4.6"
        stroke-linecap="round"
        stroke-linejoin="round"
        fill="none"
      />
    ))}
  </g>
</svg>
