---
import FullWidth from '@/layouts/FullWidth.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import { BreadcrumbItemBlog, BreadcrumbItemHome } from '@/constants/breadcrumb';

import type { BaseProps } from '@/layouts/Base.astro';

export interface Props extends BaseProps {
  /** cover color: one of the key colors */
  tone?: 'terracotta' | 'teal' | 'mustard' | 'navy';
  /** small text standing on the spine (decoration) */
  spineLabel?: string;
}

const { tone = 'terracotta', spineLabel = '', ...props } = Astro.props;
const breadcrumbs = [BreadcrumbItemHome, BreadcrumbItemBlog];
---

<FullWidth {...props}>
  <article class="relative pt-8 pb-16">
    <section class="centered-px max-w-6xl">
      <Breadcrumbs items={breadcrumbs} />
    </section>

    <header class="centered-px max-w-6xl">
      <div class="post-cover" data-tone={tone}>
        <div class="post-spine" data-label={spineLabel} aria-hidden="true"></div>
        <div class="post-cover-main" data-art={Astro.slots.has('hero-image') ? 'true' : 'false'}>
          <div>
            <slot name="hero-text" />
          </div>
          {Astro.slots.has('hero-image') && (
            <figure class="post-cover-art m-0">
              <slot name="hero-image" />
            </figure>
          )}
        </div>
        <div class="post-slip">
          <slot name="hero-meta" />
        </div>
      </div>
    </header>

    {Astro.slots.has('bottom-line') && (
      <section class="centered-px mb-8 max-w-6xl">
        <slot name="bottom-line" />
      </section>
    )}

    <section class="centered md:centered-px max-w-6xl">
      <div class="post-grid relative">
        {Astro.slots.has('toc') ? (
          <slot name="toc" />
        ) : (
          <div class="hidden lg:block" aria-hidden="true" />
        )}
        <section
          class="my-prose sheet sheet-prose post-detail [&>h2:nth-child(1)]:mt-0 [&>h2:nth-child(3)]:mt-0"
          data-translatable="content"
        >
          <content-wrapper>
            <slot name="content" />
          </content-wrapper>
        </section>
        <aside class="post-rail" aria-label="Share this post">
          <div class="post-rail-inner">
            <slot name="rail" />
          </div>
        </aside>
      </div>
    </section>

    <section class="centered-px max-w-6xl">
      <slot name="after-content" />
    </section>

    <section class="centered-px b-h2-mt max-w-6xl">
      <slot name="more-posts" />
    </section>
  </article>
</FullWidth>

<script>
  class ContentWrapper extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      // Expressive Code makes scrollable code blocks a `region` landmark without a name.
      // Give each one a unique name (the script adds the role after load, so watch for it).
      const nameCodeRegions = () => {
        this.querySelectorAll('pre[role="region"]').forEach((pre, index) => {
          if (pre.hasAttribute('aria-label')) return;
          const language = pre.getAttribute('data-language');
          pre.setAttribute(
            'aria-label',
            `Code block ${index + 1}${language ? `, ${language}` : ''}`
          );
        });
      };
      nameCodeRegions();
      new MutationObserver(nameCodeRegions).observe(this, {
        subtree: true,
        attributes: true,
        attributeFilter: ['role'],
      });

      const codeGroups = document.querySelectorAll('.rehype-code-group');
      if (!codeGroups || codeGroups.length <= 0) {
        return;
      }

      codeGroups.forEach((group) => {
        const tabs = group.querySelectorAll('.rcg-tab');
        const blocks = group.querySelectorAll('.rcg-block');
        let activeTab = group.querySelector('.rcg-tab.active');
        let activeBlock = group.querySelector('.rcg-block.active');

        group.addEventListener('click', (event) => {
          // @ts-ignore
          const tab = event?.target?.closest('.rcg-tab');
          if (!tab) return;

          const index = Array.from(tabs).indexOf(tab);
          if (index === -1) return;

          if (activeTab) {
            activeTab.classList.remove('active');
            activeTab.setAttribute('aria-selected', 'false');
          }
          if (activeBlock) {
            activeBlock.classList.remove('active');
            activeBlock.setAttribute('hidden', 'true');
          }

          tab.classList.add('active');
          tab.setAttribute('aria-selected', 'true');
          blocks[index].classList.add('active');
          blocks[index].removeAttribute('hidden');

          activeTab = tab;
          activeBlock = blocks[index];
        });
      });
    }
  }

  customElements.define('content-wrapper', ContentWrapper);
</script>
