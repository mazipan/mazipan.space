{
  "name": "mazipan.space",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "astro": "astro",
    "build:with-version": "APP_VERSION=$(npm pkg get version | xargs) APP_DEPLOY_AT=$(date +'%Y-%m-%d %H:%M:%S') astro build",
    "build": "pnpm generate && pnpm build:with-version",
    "check-types": "tsc --noEmit --pretty",
    "clean": "rm -rf node_modules pnpm-lock.yaml",
    "contrast": "node ./scripts/check-contrast.mjs",
    "dev": "APP_VERSION=$(npm pkg get version | xargs) APP_DEPLOY_AT=$(date +'%Y-%m-%d %H:%M:%S') astro dev",
    "format": "prettier --write .",
    "lint": "eslint src",
    "preview": "astro preview",
    "start": "serve ./dist",
    "generate": "node ./scripts/copy-talks.js && node ./scripts/copy-awesome-sde.js",
    "sync": "astro sync"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.10",
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/partytown": "^2.1.9",
    "@astrojs/react": "^7.1.9",
    "@astrojs/sitemap": "^3.7.5",
    "@expressive-code/core": "^0.44.4",
    "@expressive-code/plugin-collapsible-sections": "^0.44.4",
    "@expressive-code/plugin-line-numbers": "^0.44.4",
    "@fontsource-variable/atkinson-hyperlegible-next": "^5.3.0",
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "7.4.12",
    "astro-embed": "^0.14.0",
    "astro-expressive-code": "^0.44.4",
    "astro-icon": "^1.2.0",
    "astro-social-share": "^2.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "4.4.0",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "expressive-code-color-chips": "^0.2.1",
    "feed": "^6.0.0",
    "giscus": "^1.6.0",
    "github-slugger": "^2.0.0",
    "object-treeify": "^5.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "reading-time": "^1.5.0",
    "satteri": "0.11.7",
    "sharp": "0.35.5",
    "tailwind-clip-path": "^1.0.0",
    "tailwind-merge": "^3.7.0",
    "usehooks-ts": "^3.1.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@eslint/js": "^10.0.1",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@iconify-json/tabler": "^1.2.46",
    "@types/mdast": "^4.0.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-mdx": "^3.10.1",
    "eslint-plugin-astro": "^3.2.1",
    "eslint-plugin-mdx": "^3.10.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "satori": "^0.63.2",
    "satori-html": "^0.3.2",
    "serve": "^14.2.8",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.0.0"
  }
}
